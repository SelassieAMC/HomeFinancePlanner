// Session authentication middleware: everything under /api requires a valid
// login cookie except an explicit public allowlist, so the planner's data and
// mutations are only reachable from the household, not from anonymous LAN
// requests.
package middleware

import (
	"context"
	"encoding/json"
	"net/http"
	"time"

	"home-finance-planner/backend/internal/domain"
)

type ctxKeyUser struct{}

// SessionCookieName is the login cookie everyone uses.
const SessionCookieName = "hfp_session"

// publicRoute is a method+path the auth middleware lets through: the login
// page itself (user dropdown + login attempt) and the health check.
type publicRoute struct{ method, path string }

var publicRoutes = map[publicRoute]struct{}{
	{http.MethodGet, "/api/v1/auth/login-users"}: {},
	{http.MethodPost, "/api/v1/auth/login"}:      {},
	{http.MethodGet, "/api/v1/health"}:           {},
}

// SessionResolver resolves a cookie token into its user (implemented by the
// user service; passed as a func so middleware keeps no service dependency).
type SessionResolver func(ctx context.Context, token string) (domain.User, error)

// Auth enforces the session cookie on every non-public route, resolving the
// user into the request context once per request. Outside /api (the River
// UI, static shells) it is transparent.
func Auth(resolver SessionResolver, next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if len(r.URL.Path) < 5 || r.URL.Path[:5] != "/api/" {
			next.ServeHTTP(w, r)
			return
		}
		if _, ok := publicRoutes[publicRoute{r.Method, r.URL.Path}]; ok {
			next.ServeHTTP(w, r)
			return
		}

		cookie, err := r.Cookie(SessionCookieName)
		if err != nil || cookie.Value == "" {
			respondUnauthorized(w)
			return
		}
		// Expired and unknown tokens look the same to the caller: clear the
		// stale cookie so the browser stops retrying a dead one.
		user, err := resolver(r.Context(), cookie.Value)
		if err != nil {
			http.SetCookie(w, ClearSessionCookie())
			respondUnauthorized(w)
			return
		}
		next.ServeHTTP(w, r.WithContext(context.WithValue(r.Context(), userKey{}, user)))
	})
}

// UserFromContext returns the authenticated user (present on every request
// the Auth middleware let through).
func UserFromContext(ctx context.Context) (domain.User, bool) {
	if u, ok := ctx.Value(userKey{}).(domain.User); ok {
		return u, true
	}
	return domain.User{}, false
}

// userKey is a distinct context key type from the middleware.go request-id/
// logger keys — collision-proof across files.
type userKey struct{}

func respondUnauthorized(w http.ResponseWriter) {
	w.Header().Set("Content-Type", "application/json; charset=utf-8")
	w.WriteHeader(http.StatusUnauthorized)
	_ = json.NewEncoder(w).Encode(map[string]string{"error": "authentication required"})
}

// ClearSessionCookie expires the login cookie (logout + stale-token paths).
func ClearSessionCookie() *http.Cookie {
	return &http.Cookie{
		Name:     SessionCookieName,
		Value:    "",
		Path:     "/",
		MaxAge:   -1,
		HttpOnly: true,
		SameSite: http.SameSiteLaxMode,
		Expires:  time.Unix(0, 0).UTC(),
	}
}

// SessionCookie builds the login cookie for a token. Persistent sessions
// set MaxAge so the browser remembers across restarts; otherwise it is a
// browser-session cookie (dying when the browser closes) whose server-side
// row still expires on its own TTL.
func SessionCookie(token string, ttl time.Duration, persistent bool) *http.Cookie {
	c := &http.Cookie{
		Name:     SessionCookieName,
		Value:    token,
		Path:     "/",
		HttpOnly: true,
		SameSite: http.SameSiteLaxMode,
	}
	if persistent {
		c.MaxAge = int(ttl.Seconds())
	}
	return c
}