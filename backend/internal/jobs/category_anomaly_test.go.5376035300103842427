// TestEvaluateSpike pins the deterministic trigger: the rise must clear the
// threshold and the baseline must clear the noise floor.
func TestEvaluateSpike(t *testing.T) {
	cases := []struct {
		name        string
		current     int64
		baseline    int64
		risePct     float64
		minBaseline int64
		want        bool
	}{
		{"clear spike", 6000, 3000, 30, 2000, true},
		{"exactly at threshold", 3900, 3000, 30, 2000, true},
		{"below threshold", 3800, 3000, 30, 2000, false},
		{"below noise floor", 2000, 1500, 30, 2000, false},
		{"zero baseline", 6000, 0, 30, 2000, false},
		{"zero current", 0, 3000, 30, 2000, false},
		{"big baseline small rise", 21000, 20000, 30, 2000, false},
	}
	for _, c := range cases {
		got, rise := evaluateSpike(c.current, c.baseline, c.risePct, c.minBaseline)
		if got != c.want {
			t.Errorf("%s: got (%v, %.1f%%), want %v", c.name, got, rise, c.want)
		}
	}
}

// TestFoldCategoryDays pins the day-bucketing: a month in progress counts
// through today, prior months through the same day-of-month, a completed
// month counts its full span on all sides, and post-eval-month rows never
// count.
func TestFoldCategoryDays(t *testing.T) {
	conv := &fxConverter{base: "EUR", snap: domain.RateSnapshot{}}
	today := time.Date(2026, 10, 13, 0, 0, 0, 0, time.UTC)
	rows := []domain.CategoryDayCurrencyTotal{
		{Date: "2026-07-05", Currency: "EUR", TotalCents: 1500},
		{Date: "2026-09-01", Currency: "EUR", TotalCents: 2500},
		{Date: "2026-09-20", Currency: "EUR", TotalCents: 3000}, // beyond the 13th: not in an in-progress baseline
		{Date: "2026-10-02", Currency: "EUR", TotalCents: 1000},
		{Date: "2026-10-13", Currency: "EUR", TotalCents: 2000},
		{Date: "2026-10-14", Currency: "EUR", TotalCents: 9999}, // a later day: never counts
	}

	got := foldCategoryDays(rows, conv, "2026-10", monthEndOf("2026-10", today), today)
	if m := got["2026-10"]; m != 3000 {
		t.Errorf("in-progress month = %d, want 3000 (through today)", m)
	}
	if m := got["2026-09"]; m != 2500 {
		t.Errorf("in-progress baseline = %d, want 2500 (through the same day-of-month)", m)
	}

	// A completed evaluated month compares full spans on every side.
	got = foldCategoryDays(rows, conv, "2026-09", monthEndOf("2026-09", today), today)
	if m := got["2026-09"]; m != 5500 {
		t.Errorf("completed month = %d, want 5500 (full span)", m)
	}
	if m := got["2026-08"]; m != 0 {
		t.Errorf("an empty month must stay absent, got %d", m)
	}

	// A far-future evaluated month (clock race) sums nothing.
	got = foldCategoryDays(rows, conv, "2026-12", monthEndOf("2026-12", today), today)
	if m := got["2026-12"]; m != 0 {
		t.Errorf("a future month must evaluate as empty, got %d", m)
	}
}

