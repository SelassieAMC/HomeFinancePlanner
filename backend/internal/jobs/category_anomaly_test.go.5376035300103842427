// TestCategoryAnomalyTriggers drives the engine end to end over one month of
// data: prior months (m1, m2) at 3000 cents each, a spike row today.
func TestCategoryAnomalyTriggers(t *testing.T) {
	ctx := context.Background()
	today := time.Now().UTC()
	cur := today.Format("2006-01")
	curDate := today.Format("2006-01-02")
	m1 := addMonths(cur, -1) + "-01"
	m2 := addMonths(cur, -2) + "-01"
	spendRow := func(date string, cents int64) domain.CategoryDayCurrencyTotal {
		return domain.CategoryDayCurrencyTotal{Date: date, Currency: "EUR", TotalCents: cents}
	}
	baselineRows := func(curCents int64) []domain.CategoryDayCurrencyTotal {
		return []domain.CategoryDayCurrencyTotal{
			spendRow(m1, 3000), spendRow(m2, 3000), spendRow(curDate, curCents),
		}
	}
	cats := &fakeAnomalyCatRepo{cats: map[int64]domain.Category{7: {ID: 7, Name: "Utilities"}}}

	t.Run("saves the spike with the facts snapshot", func(t *testing.T) {
		store := &fakeAnomalyStore{}
		engine := newAnomalyTestEngine(store, &fakeAnomalySpendRepo{rows: baselineRows(6000)},
			&fakeAnomalyProvider{err: true}, &fakeAnomalyAI{})
		engine.categories = cats
		engine.analyzeCategory(ctx, 7, curDate, today)

		if len(store.created) != 1 {
			t.Fatalf("expected one saved finding, got %d", len(store.created))
		}
		ins := store.created[0]
		if ins.Kind != domain.ProductInsightCategorySpike || ins.CategoryID == nil || *ins.CategoryID != 7 ||
			ins.CategoryName != "Utilities" || ins.Source != "auto" || ins.Currency != "EUR" {
			t.Fatalf("finding row incomplete: %+v", ins)
		}
		if ins.Data.Month != cur || ins.Data.CurrentCents != 6000 || ins.Data.BaselineCents != 3000 {
			t.Fatalf("month facts: %+v", ins.Data)
		}
		if len(ins.Data.PriorMonths) != anomalyHistoryMonths {
			t.Fatalf("prior months facts: %+v", ins.Data.PriorMonths)
		}
		if ins.Data.ChangePct != 100 {
			t.Fatalf("rise fact: %+v", ins.Data.ChangePct)
		}
		if ins.Message == "" {
			t.Fatalf("auto wording missing")
		}
	})

	t.Run("phrases through the connector when one answers", func(t *testing.T) {
		store := &fakeAnomalyStore{}
		ai := &fakeAnomalyAI{reply: "Your utilities bill jumped this month."}
		engine := newAnomalyTestEngine(store, &fakeAnomalySpendRepo{rows: baselineRows(9000)},
			&fakeAnomalyProvider{}, ai)
		engine.categories = cats
		engine.analyzeCategory(ctx, 7, curDate, today)
		if ai.called != 1 {
			t.Fatalf("expected one phrasing call, got %d", ai.called)
		}
		if len(store.created) != 1 || store.created[0].Source != "ai" || store.created[0].Message != ai.reply {
			t.Fatalf("ai wording not used: %+v", store.created)
		}
	})

	t.Run("sparse baseline never triggers", func(t *testing.T) {
		store := &fakeAnomalyStore{}
		engine := newAnomalyTestEngine(store, &fakeAnomalySpendRepo{rows: []domain.CategoryDayCurrencyTotal{
			spendRow(m1, 3000), spendRow(curDate, 9000), // only one prior month with spend
		}}, &fakeAnomalyProvider{err: true}, &fakeAnomalyAI{})
		engine.categories = cats
		engine.analyzeCategory(ctx, 7, curDate, today)
		if len(store.created) != 0 {
			t.Fatalf("sparse baseline must not trigger: %+v", store.created)
		}
	})

	t.Run("a zero prior month does not deflate the baseline", func(t *testing.T) {
		store := &fakeAnomalyStore{}
		// 3800 vs mean(m1=3000) is a 26% rise: no trigger. Had the empty m2
		// deflated the baseline to 1500, the same 3800 would read as a 53%
		// rise and trigger — it must not.
		engine := newAnomalyTestEngine(store, &fakeAnomalySpendRepo{rows: []domain.CategoryDayCurrencyTotal{
			spendRow(m1, 3000), spendRow(curDate, 3800),
		}}, &fakeAnomalyProvider{err: true}, &fakeAnomalyAI{})
		engine.categories = cats
		engine.analyzeCategory(ctx, 7, curDate, today)
		if len(store.created) != 0 {
			t.Fatalf("26%% against 3000 must not trigger: %+v", store.created)
		}
	})

	t.Run("cooldown suppresses the same month", func(t *testing.T) {
		store := &fakeAnomalyStore{cooling: true}
		engine := newAnomalyTestEngine(store, &fakeAnomalySpendRepo{rows: baselineRows(6000)},
			&fakeAnomalyProvider{err: true}, &fakeAnomalyAI{})
		engine.categories = cats
		engine.analyzeCategory(ctx, 7, curDate, today)
		if len(store.created) != 0 {
			t.Fatalf("cooldown must suppress: %+v", store.created)
		}
	})

	t.Run("a backfilled past month compares full spans", func(t *testing.T) {
		// The evaluated month (two months back) is complete: its huge prior's
		// late-day row (the 28th) counts into the baseline — no day cutoff on
		// complete months — while the month right after the evaluated one
		// never bleeds into it.
		store := &fakeAnomalyStore{}
		engine := newAnomalyTestEngine(store, &fakeAnomalySpendRepo{rows: []domain.CategoryDayCurrencyTotal{
			spendRow(addMonths(m2, -1) + "-28", 2500), // baseline month 1 (full)
			spendRow(addMonths(m2, -2) + "-10", 3000), // baseline month 2 (full)
			spendRow(m2 + "-02", 3000),                // evaluated month
			spendRow(m2 + "-28", 3000),                // evaluated month, late-day
			spendRow(addMonths(m2, 1) + "-15", 1000),  // after the evaluated month: excluded
		}}, &fakeAnomalyProvider{err: true}, &fakeAnomalyAI{})
		engine.categories = cats
		// The trigger date's day-of-month is irrelevant for complete months.
		engine.analyzeCategory(ctx, 7, m2+"-02", today)

		if len(store.created) != 1 {
			t.Fatalf("expected the backfilled month to trigger, got %d findings", len(store.created))
		}
		ins := store.created[0]
		// Current = full evaluated month 6000 (the 28th included); baseline =
		// mean(2500, 3000) = 2750 — had the day cutoff leaked in, the 2500
		// would vanish and read 3000.
		if ins.Data.Month != m2 || ins.Data.CurrentCents != 6000 || ins.Data.BaselineCents != 2750 {
			t.Fatalf("full-span comparison facts: %+v", ins.Data)
		}
	})
}

// TestCategoryAnomalySkipsNonSpend pins the quiet exits: income/transfers
// and category-less expenses never reach the spend read (the worker returns
// before any store contact — verified through the untouched spend fake).
func TestCategoryAnomalySkipsNonSpend(t *testing.T) {
	ctx := context.Background()
	store := &fakeAnomalyStore{}
	spend := &fakeAnomalySpendRepo{}
	engine := newAnomalyTestEngine(store, spend, &fakeAnomalyProvider{err: true}, &fakeAnomalyAI{})

	cat := int64(7)
	engine.transactions = &fakeAnomalyTxRepo{txs: map[int64]domain.Transaction{
		1: {ID: 1, Kind: domain.TransactionExpense},       // no category
		2: {ID: 2, Kind: domain.TransactionIncome, CategoryID: &cat}, // income never spends
		3: {ID: 3, Kind: domain.TransactionTransfer, CategoryID: &cat},
	}}
	for id := int64(1); id <= 3; id++ {
		if err := engine.analyzeTransaction(ctx, id); err != nil {
			t.Fatalf("analyze %d: %v", id, err)
		}
	}
	if len(store.created) != 0 {
		t.Fatalf("non-spend rows must be skipped: %+v", store.created)
	}
}