package repository

import (
	"context"
	"database/sql"
	"errors"
	"fmt"
	"time"

	"home-finance-planner/backend/internal/domain"
)

// SessionRepository stores login cookie sessions: a random token (the
// HttpOnly cookie value) expiring at a fixed time. Lookups resolve the whole
// user in one join so the auth middleware never needs a second query.
type SessionRepository struct{ db *sql.DB }

func NewSessionRepository(db *sql.DB) *SessionRepository { return &SessionRepository{db: db} }

// Create inserts a new session row (token must come from crypto/rand).
func (r *SessionRepository) Create(ctx context.Context, token string, userID int64, expiresAt time.Time) error {
	_, err := r.db.ExecContext(ctx, `
		INSERT INTO sessions (token, user_id, created_at, expires_at)
		VALUES (?, ?, ?, ?)`,
		token, userID, time.Now().Unix(), expiresAt.UTC().Unix())
	if err != nil {
		return mapWriteError("create session", err)
	}
	return nil
}

// GetUser returns the owner of a still-valid token, or domain.ErrUnauthorized
// when the token is unknown or expired.
func (r *SessionRepository) GetUser(ctx context.Context, token string) (domain.User, error) {
	row := r.db.QueryRowContext(ctx, `
		SELECT u.id, u.username, u.full_name, u.password_hash, u.photo_path, u.is_admin,
		       u.created_at, u.updated_at
		FROM sessions s JOIN users u ON u.id = s.user_id
		WHERE s.token = ? AND s.expires_at > ?`,
		token, time.Now().Unix())
	u, err := scanUser(row)
	if errors.Is(err, sql.ErrNoRows) {
		return domain.User{}, domain.ErrUnauthorized
	}
	if err != nil {
		return domain.User{}, fmt.Errorf("resolve session: %w", err)
	}
	return u, nil
}

// Delete removes one session (logout of the current device).
func (r *SessionRepository) Delete(ctx context.Context, token string) error {
	if _, err := r.db.ExecContext(ctx, `DELETE FROM sessions WHERE token = ?`, token); err != nil {
		return mapWriteError("delete session", err)
	}
	return nil
}

// DeleteAllForUserExcept logs the user out everywhere except one session
// (called on a password change: the device that made the change stays
// logged in, every other remembered device of that user is revoked).
func (r *SessionRepository) DeleteAllForUserExcept(ctx context.Context, userID int64, token string) error {
	if _, err := r.db.ExecContext(ctx,
		`DELETE FROM sessions WHERE user_id = ? AND token != ?`, userID, token); err != nil {
		return mapWriteError("delete user sessions", err)
	}
	return nil
}

// PruneExpired removes expired rows — called opportunistically after a login
// creates a fresh row. Errors are best-effort noise for the caller to log.
func (r *SessionRepository) PruneExpired(ctx context.Context) (int64, error) {
	res, err := r.db.ExecContext(ctx, `DELETE FROM sessions WHERE expires_at <= ?`, time.Now().Unix())
	if err != nil {
		return 0, err
	}
	n, _ := res.RowsAffected()
	return n, nil
}