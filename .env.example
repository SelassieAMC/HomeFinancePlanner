# home-finance-planner backend configuration.
# Copy to .env and adjust. The backend reads plain environment variables —
# export the file before starting, e.g.:
#   set -a && source .env && set +a

# development | production (production REQUIRES AI_ENCRYPTION_KEY)
APP_ENV=development

# Backend HTTP listen port. Keep 5001: the Vite dev server proxies /api to
# http://localhost:5001 (see frontend/vite.config.ts). In Docker the container
# always listens on 8080 internally; the host port is BACKEND_PORT below.
PORT=5001

# SQLite database file (created and migrated automatically on first run)
DB_PATH=./data/finance.db

# Directory for uploaded receipt images
BILLS_PATH=./data/bills

# Comma-separated origins allowed to call the API; empty = same-origin only.
# Local dev and the Docker UI both use same-origin proxies (/api), so this
# stays empty. Only needed when the frontend is served from another origin.
CORS_ALLOWED_ORIGINS=

# debug | info | warn | error
LOG_LEVEL=info

# Passphrase used to encrypt AI provider API keys at rest (AES-256-GCM).
# Generate one with: openssl rand -base64 32
# WARNING: changing it later makes already-stored keys unreadable.
AI_ENCRYPTION_KEY=

# --- Docker host ports (docker compose reads this file automatically) --------
# Backend API on the host. Container-internal port stays 8080.
BACKEND_PORT=5001

# Web UI on the host (nginx serving the SPA, proxying /api to the backend).
UI_PORT=5002